{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "classifyai",
  "version": "2.3.2",
  "identifier": "com.vaibhav.classifyai",
  "build": {
    "frontendDist": "../tauri-wrapper",
    "devUrl": "https://classify-ai-five.vercel.app"
  },
  "app": {
    "windows": [
      {
        "title": "CLASSIFYAI",
        "width": 1200,
        "height": 770,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/logo.ico", "icons/32x32.png"]
  }
}