generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// ---------------------
/// Models
/// ---------------------

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String? // nullable when OAuth-only users
  role             Role
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  username         String    @unique
  fcmToken         String?
  // Profile fields
  avatarUrl        String?
  phone            String?
  branch           String?
  semester         Int?
  year             Int?
  premiumExpiresAt DateTime?

  // --- ADDED: Link user to a specific campus ---
  campusId String?
  campus   Campus? @relation(fields: [campusId], references: [id])

  // relations
  teacherProfile   Teacher?         @relation("UserToTeacher")
  studentProfile   Student?         @relation("UserToStudent")
  attendance       Attendance[]     @relation("UserAttendance")
  premiumFeatures  PremiumFeature[] @relation("UserPremiumFeatures")
  googleTokens     GoogleToken[]
  recentActivities RecentActivity[]
  supportRequests  SupportRequest[]
  notifications    Notification[]
  sessions         Session[]
  announcements    Announcement[]   @relation("AnnouncementAssistant")

  conversations             ConversationParticipant[] @relation("UserConversations")
  chatMessagesSent          Message[]                 @relation("ChatMessageSender")
  createdRiskRules          RiskRule[]                @relation("RiskRuleCreatedBy")
  acknowledgedRiskEvents    RiskEvent[]               @relation("RiskEventAcknowledgedBy")
  resolvedRiskEvents        RiskEvent[]               @relation("RiskEventResolvedBy")
  assignedSupportCases      SupportCase[]             @relation("SupportCaseAssignedAssistant")
  createdSupportCases       SupportCase[]             @relation("SupportCaseCreatedBy")
  resolvedSupportCases      SupportCase[]             @relation("SupportCaseResolvedBy")
  messageKeys               MessageKey[]              @relation("UserMessageKeys")
  MessageReaction           MessageReaction[]
  supportCaseNotes          SupportCaseNote[]         @relation("SupportCaseNoteAuthor")
  supportCaseActivities     SupportCaseActivityLog[]  @relation("SupportCaseActivityActor")
  createdCircleOfCareGroups CircleOfCareGroup[]       @relation("CircleOfCareCreatedBy")
}

model Teacher {
  id          String   @id @default(cuid())
  user        User     @relation("UserToTeacher", fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique
  department  String?
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // relations
  teacherSubjects      TeacherSubject[]
  classSessions        ClassSession[]
  attendanceTokens     AttendanceToken[]
  announcements        Announcement[]    @relation("AnnouncementAuthor")
  assignedSupportCases SupportCase[]
  assignments          Assignment[]
  TimetableEntry       TimetableEntry[]
  Conversation         Conversation[]
}

model Student {
  id         String   @id @default(cuid())
  user       User     @relation("UserToStudent", fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @unique
  rollNumber String?
  semesterId String?
  sectionId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  semester Semester? @relation("StudentSemester", fields: [semesterId], references: [id])
  section  Section?  @relation("StudentSection", fields: [sectionId], references: [id])

  attendances        Attendance[]        @relation("StudentAttendance")
  submissions        Submission[]
  grades             Grade[]
  attendanceTokens   AttendanceToken[]
  riskRuleScopes     RiskRuleScope[]
  riskEvents         RiskEvent[]
  riskProfile        StudentRiskProfile?
  supportCases       SupportCase[]
  circleOfCareGroups CircleOfCareGroup[]
}

model Semester {
  id        String   @id @default(cuid())
  name      String
  number    Int?
  createdAt DateTime @default(now())
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id])

  teacherSubjects TeacherSubject[]
  classSessions   ClassSession[]   @relation("SemesterSessions")
  students        Student[]        @relation("StudentSemester")
  TimetableEntry  TimetableEntry[]
  Conversation    Conversation[]
  riskRuleScopes  RiskRuleScope[]

  @@unique([name, campusId]) // A semester name should be unique within a campus
}

model Section {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id])

  teacherSubjects TeacherSubject[]
  classSessions   ClassSession[]   @relation("SectionSessions")
  students        Student[]        @relation("StudentSection")
  TimetableEntry  TimetableEntry[]
  Conversation    Conversation[]
  riskRuleScopes  RiskRuleScope[]

  @@unique([name, campusId])
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String?  @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campusId    String
  campus      Campus   @relation(fields: [campusId], references: [id])

  teacherSubjects  TeacherSubject[]
  classSessions    ClassSession[]    @relation("ClassSessionSubject")
  assignments      Assignment[]
  resources        Resource[]
  exams            Exam[]
  attendanceTokens AttendanceToken[]
  TimetableEntry   TimetableEntry[]
  Conversation     Conversation[]
  riskRuleScopes   RiskRuleScope[]
  riskEvents       RiskEvent[]
  supportCases     SupportCase[]

  @@unique([code, campusId])
}

model TeacherSubject {
  id String @id @default(cuid())

  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade, map: "fk_teachersubject_teacher")
  teacherId String

  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade, map: "fk_teachersubject_subject")
  subjectId String

  semester   Semester @relation(fields: [semesterId], references: [id], map: "fk_teachersubject_semester")
  semesterId String

  section   Section @relation(fields: [sectionId], references: [id], map: "fk_teachersubject_section")
  sectionId String

  @@unique([teacherId, subjectId, semesterId, sectionId], map: "uq_teachersubject_unique")
}

model Campus {
  id             String   @id @default(cuid())
  name           String   @unique
  hindiName      String?
  slug           String   @unique
  city           String
  logoUrl        String?
  latitude       Float
  longitude      Float
  geofenceRadius Int      @default(500)
  wifiBssids     String[]

  users               User[]
  classSessions       ClassSession[] // Back-relation to ClassSession
  semesters           Semester[]
  sections            Section[]
  subjects            Subject[]
  events              Event[]
  TimetableEntry      TimetableEntry[]
  TimetableDayConfig  TimetableDayConfig[]
  riskRules           RiskRule[]
  riskRuleScopes      RiskRuleScope[]
  riskEvents          RiskEvent[]
  studentRiskProfiles StudentRiskProfile[]
  supportCases        SupportCase[]
  circleOfCareGroups  CircleOfCareGroup[]
}

model ClassSession {
  id                     String        @id @default(cuid())
  date                   DateTime
  startTime              DateTime
  endTime                DateTime
  weekday                Weekday
  room                   String?
  status                 SessionStatus @default(UPCOMING)
  attendanceWindowEndsAt DateTime?
  attendanceMarked       Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  // Relations
  subjectId   String?
  subjectRel  Subject?     @relation("ClassSessionSubject", fields: [subjectId], references: [id], map: "fk_classsession_subject")
  subject     String?
  campusId    String?
  campus      Campus?      @relation(fields: [campusId], references: [id])
  semester    Int
  section     String
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id], map: "fk_classsession_teacher")
  semesterId  String?
  semesterRel Semester?    @relation("SemesterSessions", fields: [semesterId], references: [id], map: "fk_classsession_semester")
  sectionId   String?
  sectionRel  Section?     @relation("SectionSessions", fields: [sectionId], references: [id], map: "fk_classsession_section")
  attendances Attendance[] @relation("ClassSessionAttendance")
  riskEvents  RiskEvent[]

  @@unique([teacherId, subjectId, sectionId, date])
  @@index([teacherId, weekday, semester], map: "idx_classsession_teacher_weekday_semester")
  @@index([subjectId], map: "idx_classsession_subject")
  @@index([campusId], map: "idx_classsession_campus")
  @@index([date], map: "idx_classsession_date")
  @@index([subjectId, date], map: "idx_classsession_subject_date")
  @@index([semesterId, sectionId], map: "idx_classsession_semester_section")
}

model TimetableEntry {
  id        String             @id @default(cuid())
  type      TimetableEntryType @default(LECTURE)
  title     String?
  weekday   Weekday
  startTime DateTime // Stores the time, e.g., 10:00 AM
  endTime   DateTime
  room      String?

  // Relations
  campusId   String
  campus     Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  teacherId  String?
  teacher    Teacher?  @relation(fields: [teacherId], references: [id])
  subjectId  String?
  subject    Subject?  @relation(fields: [subjectId], references: [id])
  semesterId String?
  semester   Semester? @relation(fields: [semesterId], references: [id])
  sectionId  String?
  section    Section?  @relation(fields: [sectionId], references: [id])
  isActive   Boolean   @default(true)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([campusId, weekday])
  @@index([teacherId, weekday])
  @@index([semesterId, sectionId, weekday])
  @@index([subjectId])
}

model TimetableDayConfig {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  weekday   Weekday
  startTime DateTime
  endTime   DateTime
  isWorking Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campusId, weekday])
}

model Attendance {
  id String @id @default(cuid())

  classSessionId String?
  classSession   ClassSession? @relation("ClassSessionAttendance", fields: [classSessionId], references: [id], map: "fk_attendance_classsession")

  studentId String?
  student   Student? @relation("StudentAttendance", fields: [studentId], references: [id], map: "fk_attendance_student")

  userId String?
  user   User?   @relation("UserAttendance", fields: [userId], references: [id], map: "fk_attendance_user")

  status   AttendanceStatus
  markedBy String?
  markedAt DateTime?        @default(now())
  remarks  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classSessionId, studentId], map: "uq_attendance_session_student")
  @@index([classSessionId], map: "idx_attendance_classsession")
  @@index([studentId], map: "idx_attendance_student")
  @@index([status], map: "idx_attendance_status")
  @@index([studentId, status], map: "idx_attendance_student_status")
}

model AttendanceToken {
  id          String         @id @default(cuid())
  token       String         @unique
  studentId   String? // Add this field
  student     Student?       @relation(fields: [studentId], references: [id])
  subjectId   String?
  subject     Subject?       @relation(fields: [subjectId], references: [id], map: "fk_attendancetoken_subject")
  professorId String
  teacher     Teacher        @relation(fields: [professorId], references: [id])
  issuedAt    DateTime       @default(now())
  expiresAt   DateTime
  used        Boolean        @default(false)
  latitude    Float? // To store the teacher's latitude at time of creation
  longitude   Float? // To store the teacher's longitude at time of creation
  mode        AttendanceMode @default(OFFLINE)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime

  faceVerified  Boolean   @default(false)
  faceVerifieAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  type        String
  description String?
  active      Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campusId    String
  campus      Campus   @relation(fields: [campusId], references: [id])
}

model Assignment {
  id          String           @id @default(cuid())
  title       String
  description String?
  subjectId   String
  totalMarks  Int?
  status      AssignmentStatus @default(DRAFT)
  rubric      String?
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade, map: "fk_assignment_subject")
  teacherId   String
  teacher     Teacher          @relation(fields: [teacherId], references: [id], map: "fk_assignment_teacher")
  dueDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  attachments Resource[]
  submissions Submission[]
}

model Submission {
  id               String     @id @default(cuid())
  assignmentId     String
  assignment       Assignment @relation(fields: [assignmentId], references: [id], map: "fk_submission_assignment")
  studentId        String
  student          Student    @relation(fields: [studentId], references: [id], map: "fk_submission_student")
  submittedAt      DateTime   @default(now())
  fileUrl          String?
  text             String?
  grade            Float?
  feedback         String?
  gradedBy         String?
  gradedAt         DateTime?
  aiSummary        String[]
  aiProbability    Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  audioFeedbackUrl String?

  @@index([assignmentId], map: "idx_submission_assignment")
}

model Announcement {
  id             String     @id @default(cuid())
  title          String
  message        String
  authorId       String?
  author         Teacher?   @relation("AnnouncementAuthor", fields: [authorId], references: [id], map: "fk_announcement_author")
  assistantId    String?
  assistant      User?      @relation("AnnouncementAssistant", fields: [assistantId], references: [id], map: "fk_announcement_assistant")
  targetAll      Boolean    @default(false)
  targetSemester Int?
  targetSection  String?
  attachments    Resource[]
  createdAt      DateTime   @default(now())
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
}

model Resource {
  id          String  @id @default(cuid())
  title       String
  description String?
  url         String

  resourceType  ResourceType @default(NOTES)
  fileExtension String?
  aiSummary     String[]

  uploadedBy     String?
  subjectId      String?
  subject        Subject?      @relation(fields: [subjectId], references: [id], map: "fk_resource_subject")
  assignmentId   String?
  assignment     Assignment?   @relation(fields: [assignmentId], references: [id], map: "fk_resource_assignment")
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], map: "fk_resource_announcement")
  chatMessageId  String?
  chatMessage    Message?      @relation("MessageAttachments", fields: [chatMessageId], references: [id], map: "fk_resource_chatmessage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  message   Message? @relation(fields: [messageId], references: [id])
  messageId String?
}

model Exam {
  id          String   @id @default(cuid())
  title       String
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], map: "fk_exam_subject")
  date        DateTime
  durationMin Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grades Grade[]
}

model Grade {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], map: "fk_grade_exam")
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], map: "fk_grade_student")
  marks     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId], map: "uq_grade_exam_student")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], map: "fk_notification_user")
  title     String
  body      String
  meta      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PremiumFeature {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  users       User[]   @relation("UserPremiumFeatures")
  createdAt   DateTime @default(now())
}

model GoogleToken {
  userId       String    @id
  accessToken  String
  refreshToken String?
  scope        String?
  expiresAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model RecentActivity {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  timestamp DateTime @default(now())
}

model RiskRule {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  name        String
  description String?

  type      RiskRuleType
  threshold Int
  severity  RiskSeverity @default(MEDIUM)

  isActive Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("RiskRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  scopes RiskRuleScope[]
  events RiskEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campusId])
  @@index([type])
  @@index([isActive])
}

model RiskRuleScope {
  id String @id @default(cuid())

  ruleId String
  rule   RiskRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  scopeType RiskScopeType

  campusId String?
  campus   Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  semesterId String?
  semester   Semester? @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  department String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruleId])
  @@index([scopeType])
  @@index([campusId])
  @@index([subjectId])
  @@index([semesterId])
  @@index([sectionId])
  @@index([studentId])
}

model RiskEvent {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  ruleId String?
  rule   RiskRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  classSessionId String?
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: SetNull)

  type     RiskRuleType
  severity RiskSeverity @default(MEDIUM)

  title       String
  description String?

  currentValue Int?
  threshold    Int?

  status RiskEventStatus @default(ACTIVE)

  detectedAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  dismissedAt    DateTime?

  acknowledgedById String?
  acknowledgedBy   User?   @relation("RiskEventAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   User?   @relation("RiskEventResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  supportCase SupportCase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campusId])
  @@index([studentId])
  @@index([subjectId])
  @@index([ruleId])
  @@index([status])
  @@index([detectedAt])
}

model StudentRiskProfile {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  currentSeverity RiskSeverity @default(LOW)

  totalRiskEvents    Int @default(0)
  activeRiskEvents   Int @default(0)
  resolvedRiskEvents Int @default(0)

  isAtRisk Boolean @default(false)

  lastRiskDetectedAt DateTime?
  lastResolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campusId])
  @@index([isAtRisk])
  @@index([currentSeverity])
}

model SupportCase {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  riskEventId String    @unique
  riskEvent   RiskEvent @relation(fields: [riskEventId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  assignedAssistantId String?
  assignedAssistant   User?   @relation("SupportCaseAssignedAssistant", fields: [assignedAssistantId], references: [id], onDelete: SetNull)

  assignedTeacherId String?
  assignedTeacher   Teacher? @relation(fields: [assignedTeacherId], references: [id], onDelete: SetNull)

  title       String
  description String?

  status   SupportCaseStatus   @default(OPEN)
  priority SupportCasePriority @default(MEDIUM)

  firstNoticeSentAt DateTime?
  lastFollowUpAt    DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?

  internalNote String?

  createdById String?
  createdBy   User?   @relation("SupportCaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   User?   @relation("SupportCaseResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  notes             SupportCaseNote[]
  activityLogs      SupportCaseActivityLog[]
  circleOfCareGroup CircleOfCareGroup?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campusId])
  @@index([studentId])
  @@index([subjectId])
  @@index([status])
  @@index([priority])
  @@index([assignedAssistantId])
  @@index([assignedTeacherId])
}

model SupportCaseNote {
  id String @id @default(cuid())

  supportCaseId String
  supportCase   SupportCase @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("SupportCaseNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  note String

  isInternal Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supportCaseId])
  @@index([authorId])
  @@index([createdAt])
}

model SupportCaseActivityLog {
  id String @id @default(cuid())

  supportCaseId String
  supportCase   SupportCase @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("SupportCaseActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  type SupportCaseActivityType

  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([supportCaseId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
}

model CircleOfCareGroup {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  supportCaseId String      @unique
  supportCase   SupportCase @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)

  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  reason String?

  status CircleOfCareStatus @default(ACTIVE)

  createdById String?
  createdBy   User?   @relation("CircleOfCareCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campusId])
  @@index([studentId])
  @@index([status])
  @@index([createdById])
}

model SupportRequest {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], map: "fk_supportrequest_user")
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model PlanConfig {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Int
  features  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType
  name          String? // for group chats
  campusId      String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  isTeacherOnly Boolean          @default(false)

  pinnedMessageId String?
  pinnedMessage   Message? @relation("PinnedMessage", fields: [pinnedMessageId], references: [id])

  isSystemGenerated Boolean      @default(false)
  systemType        ChannelType?

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  semesterId String?
  semester   Semester? @relation(fields: [semesterId], references: [id])

  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  participants      ConversationParticipant[]
  messages          Message[]                 @relation("ConversationMessages")
  circleOfCareGroup CircleOfCareGroup?

  @@index([campusId])
  @@index([systemType])
  @@index([subjectId])
  @@index([semesterId])
  @@index([sectionId])
  @@index([teacherId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  publicKey      String // RSA public key for E2E encryption
  lastReadAt     DateTime? // for read receipts
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id               String            @id @default(cuid())
  replyToId        String?
  replyTo          Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies          Message[]         @relation("MessageReplies")
  conversationId   String
  conversation     Conversation      @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User              @relation("ChatMessageSender", fields: [senderId], references: [id])
  encryptedContent String
  attachments      Resource[]        @relation("MessageAttachments")
  encryptedKeys    MessageKey[]
  editedAt         DateTime?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  pinnedIn         Conversation[]    @relation("PinnedMessage")
  resources        Resource[]
  reactions        MessageReaction[]

  @@index([conversationId, createdAt])
}

model MessageKey {
  id           String  @id @default(cuid())
  messageId    String
  message      Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipientId  String
  recipient    User    @relation("UserMessageKeys", fields: [recipientId], references: [id])
  encryptedKey String

  @@unique([messageId, recipientId])
}

model MessageReaction {
  id    String @id @default(cuid())
  emoji String

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

